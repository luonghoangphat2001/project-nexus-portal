# Backend (be) Environment Template (.env.example)
SERVER_PORT=8080
CONTEXT_PATH=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexus_db
DB_USER=root
DB_PASSWORD=root

HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

JWT_SECRET=9a6747f6f64535e3b5acf29c3645e4612482e16136f019f945e7a3ce8b46445b
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173
 
API_PREFIX=/api
API_VERSION=1.0
API_BASE_URL=http://localhost:8080
SWAGGER_DOCS_PATH=/v3/api-docs
SWAGGER_UI_PATH=/swagger-ui.html

# Spring Boot SQL Initialization (always: run data.sql on startup, never: disable)
SQL_INIT_MODE=always

# Module 11: maximum document size (10 MiB), multipart request size (12 MiB)
REPORT_MAX_FILE_BYTES=10485760
REPORT_MAX_REQUEST_BYTES=12582912
